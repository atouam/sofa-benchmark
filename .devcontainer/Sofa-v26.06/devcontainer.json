{
  "name": "SOFA v26.06",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "SOFA_ZIP_URL": "https://github.com/sofa-framework/sofa/releases/download/v26.06.00/SOFA_v26.06.00_Linux_Python3.12.zip"
    }
  },
  "remoteUser": "vscode",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/vscode/sofagen,type=bind",
  "workspaceFolder": "/home/vscode/sofagen",

  "mounts": [
    "source=sofa-uv-cache,target=/home/vscode/.cache/uv,type=volume"
  ],

  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },

  "runArgs": [
    "--env=DISPLAY=${localEnv:DISPLAY}",
    "--volume=/tmp/.X11-unix:/tmp/.X11-unix:rw",
    "--gpus=all"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/sofa-venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
